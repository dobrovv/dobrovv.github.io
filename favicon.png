		<script type="text/javascript">
		document.addEventListener('DOMContentLoaded', function() {
			var emailField = document.getElementById('new_admin_email');
			if (emailField) {
				var parentRow = emailField.closest('tr');
				if (parentRow) {
					parentRow.style.display = 'none';
				}
			}
		});
	</script>
