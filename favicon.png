        ( function( $ ) {
            $( document ).on( 'click', '.accept-tos-prompt .button-primary', function( e ) {
                e.preventDefault();
                var button = $( this );
                button.attr( 'disabled', true );
                $.post( ajaxurl, {
                        action: 'accept_tos',
                        _wpnonce: '835958fb19'
                    } )
                    .done( function() {
                        $( '.accept-tos-prompt' ).hide();
                    } )
                    .fail( function() {
                        button.attr( 'disabled', false );
                    } );
            });
        } )( jQuery );
    </script>
